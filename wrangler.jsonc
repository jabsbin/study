{
  "name": "study",
  "compatibility_date": "2026-11-05",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "worker/index.js",
  "durable_objects": {
    "bindings": [
      {
        "name": "GARDEN_ROOM",
        "class_name": "BirthdayGarden"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-garden",
      "new_sqlite_classes": [
        "BirthdayGarden"
      ]
    }
  ]
}
